---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ComoPedir from '../components/ComoPedir.astro';
import { INFO_CATEGORIAS, type InfoCategoria } from '../data/categorias';
import { waLink } from '../config';

export function getStaticPaths() {
  return INFO_CATEGORIAS.map((info) => ({ params: { categoria: info.slug }, props: { info } }));
}

const { info } = Astro.props as { info: InfoCategoria };
const productos = (await getCollection('productos', (p) => p.data.categoria === info.id)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const otras = INFO_CATEGORIAS.filter((c) => c.id !== info.id);

// Datos estructurados para Google: preguntas frecuentes y migas de pan
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: info.preguntas.map((q) => ({
      '@type': 'Question',
      name: q.p,
      acceptedAnswer: { '@type': 'Answer', text: q.r },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Catálogo', item: new URL('/catalogo/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: info.titulo, item: new URL(`/${info.slug}/`, Astro.site).href },
    ],
  },
];
---
<Base titulo={info.titulo} descripcion={info.descripcion} imagen={productos[0]?.data.imagenes[0]}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="contenedor py-8 sm:py-12">
    <nav class="text-sm text-cuero-500" aria-label="Migas de pan">
      <a href="/catalogo/" class="underline">Catálogo</a> / <span>{info.titulo}</span>
    </nav>

    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{info.titulo}</h1>
    <div class="mt-4 max-w-3xl space-y-3 text-lg text-cuero-700">
      {info.intro.map((p) => <p>{p}</p>)}
    </div>
    <a href={waLink(info.whatsapp)} target="_blank" rel="noopener" class="btn btn-whatsapp mt-6 w-full sm:w-auto">
      Cotizar por WhatsApp
    </a>

    <h2 class="mt-12 text-2xl font-bold">Trabajos que hemos hecho</h2>
    {productos.length > 0 ? (
      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
        {productos.map((p) => <ProductCard producto={p} />)}
      </div>
    ) : (
      <p class="mt-4 text-cuero-700">Pronto agregaremos piezas aquí. Pregúntanos por WhatsApp.</p>
    )}
  </section>

  <div class="contenedor">
    <ComoPedir compacto />
  </div>

  <section class="contenedor max-w-3xl py-12">
    <h2 class="text-2xl font-bold">Preguntas frecuentes</h2>
    <div class="mt-6 divide-y divide-cuero-200 rounded-xl bg-white shadow-sm ring-1 ring-cuero-100">
      {info.preguntas.map((q) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold">
            {q.p}
            <span class="ml-4 text-2xl leading-none transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-cuero-700">{q.r}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="contenedor pb-4">
    <h2 class="text-xl font-bold">También hacemos</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {otras.map((c) => (
        <a href={`/${c.slug}/`} class="rounded-full bg-white px-4 py-2 text-sm font-semibold shadow-sm ring-1 ring-cuero-200 hover:bg-cuero-100">
          {c.nombre}
        </a>
      ))}
    </div>
  </section>
</Base>