---
import Base from '../layouts/Base.astro';
import { SITE, CATEGORIAS, waLink } from '../config';
---
<Base titulo="Pedidos especiales" descripcion="Pide tu fuste, espuelas, frenos, hebillas o estribos de acero a la medida, con grabado o iniciales.">
  <section class="contenedor max-w-2xl py-8 sm:py-12">
    <h1 class="text-3xl font-bold sm:text-4xl">Pedidos especiales</h1>
    <p class="mt-3 text-cuero-700">
      Cuéntanos qué pieza necesitas y te mandamos la cotización. Si tienes una foto de referencia, súbela.
    </p>

    <form action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-5">
      <input type="hidden" name="access_key" value={SITE.web3formsKey} />
      <input type="hidden" name="subject" value={`Nuevo pedido especial - ${SITE.nombre}`} />
      <input type="hidden" name="redirect" value={new URL('/gracias/', Astro.site).href} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class="label" for="nombre">Nombre</label>
          <input class="input" id="nombre" name="nombre" required autocomplete="name" />
        </div>
        <div>
          <label class="label" for="telefono">WhatsApp / teléfono</label>
          <input class="input" id="telefono" name="telefono" type="tel" required autocomplete="tel" inputmode="tel" />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class="label" for="tipo">Tipo de pieza</label>
          <select class="input" id="tipo" name="tipo" required>
            <option value="">Selecciona…</option>
            {CATEGORIAS.map((c) => <option value={c.nombre}>{c.nombre}</option>)}
          </select>
        </div>
        <div>
          <label class="label" for="ciudad">Ciudad / estado</label>
          <input class="input" id="ciudad" name="ciudad" placeholder="Para calcular el envío" />
        </div>
      </div>

      <div>
        <label class="label" for="pieza">Pieza de referencia (opcional)</label>
        <input class="input" id="pieza" name="pieza" placeholder="Ej. Fuste forrado en acero" />
      </div>

      <div>
        <label class="label" for="medidas">Medidas</label>
        <input class="input" id="medidas" name="medidas" placeholder="Si aplica: tamaño, talla, medida de la pieza…" />
      </div>

      <div>
        <label class="label" for="detalles">Detalles: nombre, iniciales, fierro, diseño, acabado (plateado, dorado, negro)</label>
        <textarea class="input min-h-32" id="detalles" name="detalles" required></textarea>
      </div>

      <p class="rounded-lg bg-cuero-100 p-4 text-sm">
        📷 ¿Tienes foto de referencia? Después de enviar, mándala por
        <a href={waLink('Hola, acabo de enviar un pedido especial y les mando la foto de referencia.')} target="_blank" rel="noopener" class="font-semibold underline">WhatsApp</a>.
      </p>

      <button type="submit" class="btn btn-primario w-full sm:w-auto">Enviar pedido</button>
    </form>
  </section>
</Base>

<script>
  // Si viene de un producto (?pieza=...), se llena solo
  const pieza = new URLSearchParams(location.search).get('pieza');
  if (pieza) (document.getElementById('pieza') as HTMLInputElement).value = pieza;
</script>
