---
import Base from '../layouts/Base.astro';
import { SITE, waLink } from '../config';

const faqs = SITE.preguntas;
---
<Base titulo="Contacto" descripcion={`Contacta a ${SITE.nombre}: WhatsApp, teléfono, dirección y horario.`}>
  <section class="contenedor py-8 sm:py-12">
    <h1 class="text-3xl font-bold sm:text-4xl">Contacto</h1>

    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div class="space-y-5">
        <a href={waLink('Hola, quiero información.')} target="_blank" rel="noopener" class="btn btn-whatsapp w-full sm:w-auto">
          Escríbenos por WhatsApp
        </a>
        <dl class="space-y-4">
          <div>
            <dt class="font-bold">Teléfono</dt>
            {/* Si hay varios números separados por "/", cada uno lleva su propia liga */}
            {SITE.telefono.split('/').map((t) => (
              <dd><a href={`tel:${t.replace(/\s/g, '')}`} class="underline">{t.trim()}</a></dd>
            ))}
          </div>
          <div><dt class="font-bold">Correo</dt><dd><a href={`mailto:${SITE.email}`} class="underline">{SITE.email}</a></dd></div>
          <div><dt class="font-bold">Dirección</dt><dd>{SITE.direccion}</dd></div>
          <div><dt class="font-bold">Horario</dt><dd>{SITE.horario}</dd></div>
        </dl>
      </div>

      <div class="aspect-square overflow-hidden rounded-xl bg-cuero-100 sm:aspect-video md:aspect-square">
        {SITE.mapaEmbed ? (
          <iframe src={SITE.mapaEmbed} class="h-full w-full border-0" loading="lazy" title="Ubicación del taller" referrerpolicy="no-referrer-when-downgrade"></iframe>
        ) : (
          <div class="flex h-full items-center justify-center p-6 text-center text-cuero-500">Pega el link del mapa en el panel: Configuración → Datos del sitio</div>
        )}
      </div>
    </div>
  </section>

  <section class="contenedor max-w-3xl pb-8">
    <h2 class="text-2xl font-bold sm:text-3xl">Preguntas frecuentes</h2>
    <div class="mt-6 divide-y divide-cuero-200 rounded-xl bg-white shadow-sm ring-1 ring-cuero-100">
      {faqs.map((f) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold">
            {f.p}
            <span class="ml-4 transition group-open:rotate-45 text-2xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-cuero-700">{f.r}</p>
        </details>
      ))}
    </div>
  </section>
</Base>