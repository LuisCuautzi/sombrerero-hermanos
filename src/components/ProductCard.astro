---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIAS, waLink } from '../config';

interface Props {
  producto: CollectionEntry<'productos'>;
}
const { producto } = Astro.props;
const { nombre, categoria, imagenes, resumen, video } = producto.data;
const cat = CATEGORIAS.find((c) => c.id === categoria)?.nombre;
const href = `/catalogo/${producto.id}/`;
// Link completo para que WhatsApp muestre la vista previa con la foto
const urlCompleta = new URL(href, Astro.site).href;
---
<article
  data-categoria={categoria}
  class="producto group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-cuero-100 transition hover:shadow-md"
>
  <div class="relative aspect-square overflow-hidden bg-cuero-100">
    <img
      src={imagenes[0]}
      alt={nombre}
      loading="lazy"
      width="600"
      height="600"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    {video && (
       <>
         <video
           data-preview
           src={video}
           poster={imagenes[0]}
           muted
           loop
           playsinline
           preload="none"
           aria-hidden="true"
           class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500"
         ></video>
         <span class="absolute right-2 top-2 rounded-full bg-black/60 px-2 py-1 text-xs font-semibold text-white">▶ Video</span>
       </>
     )}

    <!-- Botón de WhatsApp: va encima del link de la tarjeta (z-10) -->
    <a
      href={waLink(`Hola, me interesa esta pieza: ${nombre}\n${urlCompleta}`)}
      target="_blank"
      rel="noopener"
      class="absolute bottom-2 right-2 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-whatsapp text-white shadow-md transition hover:scale-110"
      aria-label={`Preguntar por ${nombre} en WhatsApp`}
      title="Preguntar por WhatsApp"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.01a9.870 9.870 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.860 9.860 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.820 9.820 0 0 1 2.890 6.99c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.880 11.880 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.170-3.48-8.41"/></svg>
    </a>
  </div>
  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <span class="text-xs font-semibold uppercase tracking-wide text-cuero-500">{cat}</span>
    <h3 class="mt-1 text-base font-bold leading-snug sm:text-lg">
      <!-- Este link cubre toda la tarjeta (after:absolute inset-0) -->
      <a href={href} class="after:absolute after:inset-0">{nombre}</a>
    </h3>
    <p class="mt-1 line-clamp-2 hidden text-sm text-cuero-700 sm:block">{resumen}</p>
    {/* Precio oculto por ahora. Para mostrarlo: {producto.data.precio ?? 'Cotizar'} */}
    <p class="mt-auto pt-2 text-sm font-semibold text-acero">Cotizar</p>
  </div>
</article>

<script>
  // Reproduce los videos de las tarjetas solo mientras se ven en pantalla.
  // No se activa si el usuario pidió ahorrar datos o reducir animaciones.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-preview]');
  const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const ahorro = conexion?.saveData || matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (videos.length && !ahorro && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.6 },
    );
    videos.forEach((v) => {
      v.addEventListener('playing', () => v.classList.add('opacity-100'));
      observador.observe(v);
    });
  }
</script>