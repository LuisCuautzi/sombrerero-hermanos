---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIAS } from '../config';

interface Props {
  producto: CollectionEntry<'productos'>;
}
const { producto } = Astro.props;
const { nombre, categoria, imagenes, resumen, video } = producto.data;
const cat = CATEGORIAS.find((c) => c.id === categoria)?.nombre;
---
<a
  href={`/catalogo/${producto.id}/`}
  data-categoria={categoria}
  class="producto group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-cuero-100 transition hover:shadow-md"
>
  <div class="relative aspect-square overflow-hidden bg-cuero-100">
    <img
      src={imagenes[0]}
      alt={nombre}
      loading="lazy"
      width="600"
      height="600"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    {video && <span class="absolute right-2 top-2 rounded-full bg-black/60 px-2 py-1 text-xs font-semibold text-white">▶ Video</span>}
  </div>
  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <span class="text-xs font-semibold uppercase tracking-wide text-cuero-500">{cat}</span>
    <h3 class="mt-1 text-base font-bold leading-snug sm:text-lg">{nombre}</h3>
    <p class="mt-1 line-clamp-2 hidden text-sm text-cuero-700 sm:block">{resumen}</p>
    {/* Precio oculto por ahora. Para mostrarlo: {producto.data.precio ?? 'Cotizar'} */}
    <p class="mt-auto pt-2 text-sm font-semibold text-acero">Cotizar</p>
  </div>
</a>
