---
import '../styles/global.css';
import { SITE, waLink } from '../config';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}
const { titulo, descripcion = SITE.descripcion, imagen = '/img/og-image.png' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nombre}` : `${SITE.nombre} · ${SITE.eslogan}`;
const ruta = Astro.url.pathname;
const canonical = new URL(ruta, Astro.site);

const links = [
  { href: '/', texto: 'Inicio' },
  { href: '/catalogo/', texto: 'Catálogo' },
  { href: '/pedidos/', texto: 'Pedidos especiales' },
  { href: '/clientes/', texto: 'Clientes' },
  { href: '/nosotros/', texto: 'Nosotros' },
  { href: '/contacto/', texto: 'Contacto' },
];
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3a2414" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svgxml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL(imagen, Astro.site)} />
    <meta property="og:locale" content="es_MX" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-40 border-b border-cuero-200 bg-cuero-50/95 backdrop-blur">
      <div class="contenedor flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2" aria-label={`${SITE.nombre} - Inicio`}>
          <img src="/favicon.svg" alt="" width="40" height="40" class="h-10 w-10" />
          <span class="font-display text-lg font-bold leading-tight sm:text-xl">
            <!-- Nombre corto en celular y tablet; completo en pantallas grandes -->
            <span class="lg:hidden">{SITE.nombreCorto}</span>
            <span class="hidden lg:inline">{SITE.nombre}</span>
          </span>
        </a>

        <nav class="hidden md:block" aria-label="Principal">
          <ul class="flex gap-6 text-sm font-semibold">
            {links.map((l) => (
              <li>
                <a href={l.href} class:list={['hover:text-cuero-500', activo(l.href) && 'text-cuero-500']}>{l.texto}</a>
              </li>
            ))}
          </ul>
        </nav>

        <button
          id="btn-menu"
          class="-mr-2 flex h-12 w-12 items-center justify-center md:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="menu-movil"
        >
          <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>

      <nav id="menu-movil" class="hidden border-t border-cuero-200 md:hidden" aria-label="Menú móvil">
        <ul class="contenedor py-2">
          {links.map((l) => (
            <li>
              <a href={l.href} class:list={['block py-3 text-lg font-semibold', activo(l.href) && 'text-cuero-500']}>{l.texto}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 bg-cuero-900 pb-24 pt-10 text-cuero-100 md:pb-10">
      <div class="contenedor grid gap-8 md:grid-cols-3">
        <div>
          <img src="/img/logo-claro.svg" alt={SITE.nombre} width="180" height="154" loading="lazy" class="w-44" />
          <p class="mt-2 text-sm">{SITE.eslogan}</p>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">Contacto</p>
          <p class="mt-2">{SITE.telefono}</p>
          <p>{SITE.email}</p>
          <p class="mt-2">{SITE.horario}</p>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">Síguenos</p>
          <div class="mt-2 flex gap-4">
            <a href={SITE.facebook} target="_blank" rel="noopener" class="underline">Facebook</a>
            <a href={SITE.instagram} target="_blank" rel="noopener" class="underline">Instagram</a>
            <a href={SITE.tiktok} target="_blank" rel="noopener" class="underline">TikTok</a>
          </div>
        </div>
      </div>
      <p class="contenedor mt-8 text-xs text-cuero-200">© {new Date().getFullYear()} {SITE.nombre}. Hecho a mano en México.</p>
    </footer>

    <!-- WhatsApp flotante -->
    <a
      href={waLink(`Hola, vengo de la página web de ${SITE.nombre} y me gustaría información.`)}
      target="_blank"
      rel="noopener"
      class="fixed bottom-4 right-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg transition hover:scale-105"
      aria-label="Escríbenos por WhatsApp"
    >
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.17-3.48-8.41"/></svg>
    </a>

    <script>
      const btn = document.getElementById('btn-menu');
      const menu = document.getElementById('menu-movil');
      btn?.addEventListener('click', () => {
        const abierto = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(abierto));
      });
    </script>
  </body>
</html>
